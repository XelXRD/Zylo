# Copy to .env and change the password before first start.
POSTGRES_PASSWORD=change-me-to-something-long

# Encrypts API keys and tokens stored in the database. Any random string, 32+ characters.
# Generate one in PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# or on Mac/Linux:  openssl rand -base64 48
# Keep it safe: if it changes, saved integrations must be connected again.
ZYLO_SECRET=

# Port Zylo is served on.
ZYLO_PORT=3000

# Set to true once Zylo is behind HTTPS (for example via Caddy).
COOKIE_SECURE=false

# Only used when running the apps outside Docker (pnpm dev:*).
DATABASE_URL=postgresql://zylo:change-me-to-something-long@localhost:5432/zylo
REDIS_URL=redis://localhost:6379
