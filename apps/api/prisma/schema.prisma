generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  isAdmin      Boolean   @default(false)
  settings     Json      @default("{}")
  createdAt    DateTime  @default(now())
  profiles     Profile[]
  sessions     Session[]
}

model Session {
  // sha256 of the cookie token; the raw token is never stored
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Server-wide connections (TMDB, TVDB, later Trakt and others). Admin-managed.
model Integration {
  id            String    @id // "tmdb" | "tvdb"
  secret        String // AES-256-GCM encrypted JSON; never sent to the browser
  settings      Json      @default("{}")
  lastCheckedAt DateTime?
  lastError     String?
  updatedAt     DateTime  @updatedAt
}

enum MediaType {
  movie
  series
  season
  episode
}

// One canonical record per film, series, season and episode.
model MediaItem {
  id            String       @id @default(uuid())
  type          MediaType
  parentId      String?
  parent        MediaItem?   @relation("Children", fields: [parentId], references: [id], onDelete: Cascade)
  children      MediaItem[]  @relation("Children")
  title         String
  originalTitle String?
  overview      String?
  year          Int?
  releaseDate   String? // ISO date as published; no timezone
  runtime       Int? // minutes
  posterPath    String?
  backdropPath  String?
  rating        Float?
  seasonNumber  Int?
  episodeNumber Int?
  data          Json         @default("{}") // genres, cast, trailer, certifications, seasons, recommendations
  language      String
  refreshedAt   DateTime     @default(now())
  createdAt     DateTime     @default(now())
  externalIds   ExternalId[]
  watchEvents   WatchEvent[]
  ratings       Rating[]
  inCollections CollectionItem[]

  @@index([parentId])
  @@index([refreshedAt])
}

// IDs from other systems. TMDB movie and TV ids share number space, so `type` is part of the key.
model ExternalId {
  mediaItemId String
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  system      String // tmdb | tvdb | imdb
  type        MediaType
  value       String

  @@id([system, type, value])
  @@index([mediaItemId])
}

model Profile {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String
  createdAt DateTime @default(now())

  trakt          TraktAccount?
  watchEvents    WatchEvent[]
  ratings        Rating[]
  collections    Collection[]
  traktOutbox    TraktOutbox[]

  @@unique([userId, name])
}

// --- Phase 3: per-profile tracking. Zylo keeps its own copy so it works without Trakt. ---

model TraktAccount {
  profileId      String    @id
  profile        Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  secret         String // encrypted { accessToken, refreshToken }
  expiresAt      DateTime
  username       String
  syncEnabled    Boolean   @default(true)
  syncState      String    @default("idle") // idle | queued | running
  lastSyncAt     DateTime?
  lastActivities Json?
  lastError      String?
  createdAt      DateTime  @default(now())
}

// Episodes are identified by their series + season/episode number; -1 means "not an episode".
model WatchEvent {
  id            String    @id @default(uuid())
  profileId     String
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mediaItemId   String
  mediaItem     MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  seasonNumber  Int       @default(-1)
  episodeNumber Int       @default(-1)
  watchedAt     DateTime
  source        String // zylo | trakt

  @@unique([profileId, mediaItemId, seasonNumber, episodeNumber, watchedAt])
  @@index([profileId, watchedAt])
}

model Rating {
  profileId     String
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mediaItemId   String
  mediaItem     MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  seasonNumber  Int       @default(-1)
  episodeNumber Int       @default(-1)
  rating        Int // 1-10, as Trakt
  ratedAt       DateTime

  @@id([profileId, mediaItemId, seasonNumber, episodeNumber])
}

// The watchlist (key "watchlist") and personal lists (key "trakt:<id>").
model Collection {
  id          String           @id @default(uuid())
  profileId   String
  profile     Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  key         String
  name        String
  description String?
  updatedAt   DateTime         @updatedAt
  items       CollectionItem[]

  @@unique([profileId, key])
}

model CollectionItem {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  mediaItemId  String
  mediaItem    MediaItem  @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@id([collectionId, mediaItemId])
}

// Changes Zylo couldn't push to Trakt yet; retried on every sync.
model TraktOutbox {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  path      String
  body      Json
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
}
