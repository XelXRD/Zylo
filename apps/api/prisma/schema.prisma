generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  isAdmin      Boolean   @default(false)
  settings     Json      @default("{}")
  createdAt    DateTime  @default(now())
  profiles     Profile[]
  sessions     Session[]
  addons       Addon[]
  debrid       DebridAccount[]
}

// Stremio addons, per account (shared by its profiles). The transport URL often carries the user's
// own keys in its path, so it's encrypted and only the host is ever shown.
model Addon {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  addonId       String // manifest.id
  transportUrl  String // encrypted manifest URL
  host          String
  manifest      Json
  enabled       Boolean   @default(true)
  position      Int
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@unique([userId, addonId])
}

model Session {
  // sha256 of the cookie token; the raw token is never stored
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Server-wide connections (TMDB, TVDB, later Trakt and others). Admin-managed.
model Integration {
  id            String    @id // "tmdb" | "tvdb"
  secret        String // AES-256-GCM encrypted JSON; never sent to the browser
  settings      Json      @default("{}")
  lastCheckedAt DateTime?
  lastError     String?
  updatedAt     DateTime  @updatedAt
}

enum MediaType {
  movie
  series
  season
  episode
}

// One canonical record per film, series, season and episode.
model MediaItem {
  id            String       @id @default(uuid())
  type          MediaType
  parentId      String?
  parent        MediaItem?   @relation("Children", fields: [parentId], references: [id], onDelete: Cascade)
  children      MediaItem[]  @relation("Children")
  title         String
  originalTitle String?
  overview      String?
  year          Int?
  releaseDate   String? // ISO date as published; no timezone
  runtime       Int? // minutes
  posterPath    String?
  backdropPath  String?
  rating        Float?
  seasonNumber  Int?
  episodeNumber Int?
  data          Json         @default("{}") // genres, cast, trailer, certifications, seasons, recommendations
  language      String
  refreshedAt   DateTime     @default(now())
  createdAt     DateTime     @default(now())
  externalIds   ExternalId[]
  watchEvents   WatchEvent[]
  ratings       Rating[]
  inCollections CollectionItem[]
  progress      PlaybackProgress[]
  sourceChoices SourceChoice[]

  @@index([parentId])
  @@index([refreshedAt])
}

// IDs from other systems. TMDB movie and TV ids share number space, so `type` is part of the key.
model ExternalId {
  mediaItemId String
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  system      String // tmdb | tvdb | imdb
  type        MediaType
  value       String

  @@id([system, type, value])
  @@index([mediaItemId])
}

model Profile {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String
  settings  Json     @default("{}") // playback preferences
  createdAt DateTime @default(now())

  trakt          TraktAccount?
  progress       PlaybackProgress[]
  sourceChoices  SourceChoice[]
  watchEvents    WatchEvent[]
  ratings        Rating[]
  collections    Collection[]
  traktOutbox    TraktOutbox[]
  animeAccounts  AnimeAccount[]
  animeEntries   AnimeEntry[]

  @@unique([userId, name])
}

// --- Phase 3: per-profile tracking. Zylo keeps its own copy so it works without Trakt. ---

model TraktAccount {
  profileId      String    @id
  profile        Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  secret         String // encrypted { accessToken, refreshToken }
  expiresAt      DateTime
  username       String
  syncEnabled    Boolean   @default(true)
  syncState      String    @default("idle") // idle | queued | running
  lastSyncAt     DateTime?
  lastActivities Json?
  lastError      String?
  createdAt      DateTime  @default(now())
}

// Episodes are identified by their series + season/episode number; -1 means "not an episode".
model WatchEvent {
  id            String    @id @default(uuid())
  profileId     String
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mediaItemId   String
  mediaItem     MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  seasonNumber  Int       @default(-1)
  episodeNumber Int       @default(-1)
  watchedAt     DateTime
  source        String // zylo | trakt

  @@unique([profileId, mediaItemId, seasonNumber, episodeNumber, watchedAt])
  @@index([profileId, watchedAt])
}

model Rating {
  profileId     String
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mediaItemId   String
  mediaItem     MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  seasonNumber  Int       @default(-1)
  episodeNumber Int       @default(-1)
  rating        Int // 1-10, as Trakt
  ratedAt       DateTime

  @@id([profileId, mediaItemId, seasonNumber, episodeNumber])
}

// The watchlist (key "watchlist") and personal lists (key "trakt:<id>").
model Collection {
  id          String           @id @default(uuid())
  profileId   String
  profile     Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  key         String
  name        String
  description String?
  updatedAt   DateTime         @updatedAt
  items       CollectionItem[]

  @@unique([profileId, key])
}

model CollectionItem {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  mediaItemId  String
  mediaItem    MediaItem  @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@id([collectionId, mediaItemId])
}

// --- Phase 5: playback ---

// Where each profile got to, per film or episode (-1 = not an episode). Shared across devices.
model PlaybackProgress {
  profileId     String
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mediaItemId   String
  mediaItem     MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  seasonNumber  Int       @default(-1)
  episodeNumber Int       @default(-1)
  position      Float // seconds
  duration      Float // seconds
  completed     Boolean   @default(false)
  updatedAt     DateTime  @updatedAt

  @@id([profileId, mediaItemId, seasonNumber, episodeNumber])
  @@index([profileId, updatedAt])
}

// The source a profile last picked by hand for a film or series; preferred next time.
model SourceChoice {
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mediaItemId String
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  addonId     String
  quality     String?
  updatedAt   DateTime  @updatedAt

  @@id([profileId, mediaItemId])
}

// Changes Zylo couldn't push to Trakt yet; retried on every sync.
model TraktOutbox {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  path      String
  body      Json
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
}

// Debrid services (TorBox, Real-Debrid, Premiumize), per account. The API key is encrypted.
model DebridAccount {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   String // torbox | realdebrid | premiumize
  secret    String
  createdAt DateTime @default(now())

  @@unique([userId, service])
}

// AniList / MyAnimeList, per profile. The token (and MAL's refresh token) is encrypted.
model AnimeAccount {
  id           String    @id @default(uuid())
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tracker      String // anilist | mal
  userName     String
  token        String
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())

  @@unique([profileId, tracker])
}

// One anime on a profile's tracker list. progress > pushedProgress = watched in Zylo, not yet sent.
model AnimeEntry {
  id             String   @id @default(uuid())
  profileId      String
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tracker        String
  remoteId       Int // AniList or MAL id
  title          String
  status         String // watching | completed | paused | dropped | planning
  progress       Int      @default(0)
  pushedProgress Int      @default(0)
  episodes       Int?
  score          Float?
  mediaItemId    String? // the Zylo film or series, once matched
  mapped         Boolean  @default(false) // a match was attempted
  updatedAt      DateTime @updatedAt

  @@unique([profileId, tracker, remoteId])
}
